ARG BASE_IMAGE=quay.io/toolbx/arch-toolbox@sha256:6ec5035d4038d6dbec37ce67891e9fc2e0dfa6566fa9635a61e281115ef5c295
FROM ${BASE_IMAGE}
ARG ARCH_SNAPSHOT
ARG AUR_COMMIT
ARG NOCTALIA_COMMIT
COPY common/arch /tmp/common-arch
RUN chmod 0755 /tmp/common-arch/provision.sh && /tmp/common-arch/provision.sh && \
    test -n "${AUR_COMMIT}" && test -n "${NOCTALIA_COMMIT}" && \
    for attempt in 1 2 3; do \
      if pacman -Sy --needed --noconfirm pipewire wireplumber; then break; fi; \
      test "${attempt}" -lt 3 || exit 1; sleep "${attempt}"; \
    done && \
    for attempt in 1 2 3; do \
      if sudo -H -u builder git clone https://aur.archlinux.org/noctalia-git.git /var/build/noctalia-git; then break; fi; \
      rm -rf /var/build/noctalia-git; test "${attempt}" -lt 3 || exit 1; sleep "${attempt}"; \
    done && \
    sudo -H -u builder git -C /var/build/noctalia-git checkout --detach "${AUR_COMMIT}" && \
    test "$(grep -c '#branch=main' /var/build/noctalia-git/PKGBUILD)" -eq 1 && \
    sed -i "s/#branch=main/#commit=${NOCTALIA_COMMIT}/" /var/build/noctalia-git/PKGBUILD && \
    grep -Fq "#commit=${NOCTALIA_COMMIT}" /var/build/noctalia-git/PKGBUILD && \
    sudo -H -u builder bash -lc 'cd /var/build/noctalia-git && makepkg -si --noconfirm --needed' && \
    pacman -Q noctalia-git && \
    printf '\nIgnorePkg = noctalia-git\n' >> /etc/pacman.conf && \
    rm -rf /var/build/noctalia-git /tmp/common-arch
LABEL io.atty303.distrobox.noctalia-aur-commit="${AUR_COMMIT}" \
      io.atty303.distrobox.noctalia-commit="${NOCTALIA_COMMIT}" \
      io.atty303.distrobox.arch-snapshot="${ARCH_SNAPSHOT}"
ENTRYPOINT []
